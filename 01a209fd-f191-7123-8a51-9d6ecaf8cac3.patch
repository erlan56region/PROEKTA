+        if (!text) return;
+        ta.value = '';
+        ta.style.height = 'auto';
+        try {
+          const r = await API.post(`/api/chats/${encodeURIComponent(chat.chat.id)}/messages`, { text });
+          appendMessage(r.message);
+        } catch (e) { toast(e.message, 'err'); ta.value = text; }
