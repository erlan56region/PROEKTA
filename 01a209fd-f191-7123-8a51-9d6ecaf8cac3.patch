+
+    const del = $('[data-delete-ad]');
+    if (del) del.onclick = async () => {
+      if (!(await confirmDialog('Снять объявление?', 'Объявление перестанет показываться в поиске, но останется в архиве «Моих объявлений» — его можно вернуть.'))) return;
+      try {
