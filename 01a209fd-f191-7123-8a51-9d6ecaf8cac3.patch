+  /* ---- чаты ---- */
+  async function renderChats(chatId) {
+    if (!state.me) { app.innerHTML = Views.loginRequired('Чтобы переписываться с продавцами, войдите в аккаунт.'); return; }
+    const list = await API.get('/api/chats');
