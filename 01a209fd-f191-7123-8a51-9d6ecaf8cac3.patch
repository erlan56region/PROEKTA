-.story-in{width:100%;height:100%;border-radius:50%;background:var(--bg);padding:3px}
-.story-ava{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;background:var(--bg2)}
-.story-add .story-ring{background:var(--primary-soft)}
-.story-add .story-ava{background:transparent;color:var(--primary);font-size:30px;font-weight:300}
-.story-name{font-size:11px;color:var(--muted);max-width:82px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
