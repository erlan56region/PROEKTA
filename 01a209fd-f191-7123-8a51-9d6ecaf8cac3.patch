+      ${active.length ? `<div class="grid">${active.map(card).join('')}</div>` : `<div class="empty">Вы ещё ничего не размещали. <a href="/new" data-link style="color:var(--primary)">Разместить объявление</a></div>`}
+      ${archived.length ? `
