-/* ===== Stats dark card ===== */
-.stats{background:linear-gradient(135deg,#09090b,#27272a);color:#fff;border-radius:20px;padding:22px;display:flex;gap:18px;justify-content:space-between;flex-wrap:wrap;margin-bottom:24px;border:1px solid var(--border)}
