+    'reviews': ('createdAt',),
+}
+ID_PREFIXES = {'users': 'u_', 'ads': 'a_', 'chats': 'c_', 'messages': 'm_', 'deals': 'd_', 'reviews': 'r_'}
+ID_FIELDS = ('id', 'ownerId', 'userId', 'adId', 'buyerId', 'sellerId', 'chatId', 'fromId', 'toId', 'dealId')
