-/* ===== Stories ===== */
-.stories{display:flex;gap:12px;overflow-x:auto;padding:16px 2px 6px;cursor:grab}
-.story{width:82px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:6px}
-.story-ring{width:68px;height:68px;border-radius:50%;padding:3px;background:conic-gradient(from 30deg,#f59e0b,#e11d48,#8b5cf6,#f59e0b)}
