+  }
+
+  function myAds(state) {
+    if (!state.me) return loginRequired('Войдите, чтобы управлять объявлениями.');
+    const items = state.myAds || [];
+    // снятые объявления не теряются: лежат в архиве и возвращаются в публикацию одной кнопкой
