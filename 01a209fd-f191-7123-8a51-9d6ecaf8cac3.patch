+          <a class="side-link" href="/deals" data-link>Сделки ${c.deals ? `<span class="muted small">${c.deals}</span>` : ''}</a>
+          <a class="side-link" href="/favorites" data-link>Избранное ${c.favorites ? `<span class="muted small">${c.favorites}</span>` : ''}</a>
