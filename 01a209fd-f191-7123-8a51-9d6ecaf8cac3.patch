+          toast(r.favorite ? 'Добавлено в избранное' : 'Удалено из избранного');
+        } catch (err) { toast(err.message, 'err'); }
+      };
+    });
+  }
+
+  // Глобальный делегированный обработчик (для карточек, отрисованных позже)
