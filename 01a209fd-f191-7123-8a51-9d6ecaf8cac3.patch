-.search-box{flex:1;display:flex;min-width:200px;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--card)}
-.search-box input{flex:1;border:none;background:transparent;padding:0 14px;height:42px;outline:none;min-width:0}
-.search-box button{background:var(--primary);color:#fff;padding:0 20px;font-weight:700}
-.search-box button:hover{background:var(--primary-h)}
-@media(max-width:640px){.search-row .btn{height:38px}.search-box input{height:38px}}
