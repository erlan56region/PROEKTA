-.cat-menu{position:absolute;top:calc(100% + 8px);left:0;z-index:50;width:min(560px,90vw);background:var(--card);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:10px;display:none;max-height:60vh;overflow:auto}
