+    const focusables = () => Array.from(backdrop.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
+      .filter(isVisible);
+    const close = () => {
+      root.innerHTML = '';
+      document.removeEventListener('keydown', onKey);
+      // возвращаем фокус туда, откуда диалог открыли
+      if (modalOpener && modalOpener.focus) { try { modalOpener.focus(); } catch (e) {} }
+      modalOpener = null;
+    };
+    backdrop.addEventListener('click', (e) => {
+      if (e.target === backdrop || e.target.closest('[data-close]')) close();
+    });
+    function onKey(e) {
+      if (e.key === 'Escape') { close(); return; }
+      // Tab внутри диалога не должен уводить фокус на страницу под ним
+      if (e.key === 'Tab') {
+        const list = focusables();
+        if (!list.length) return;
+        const first = list[0], last = list[list.length - 1];
+        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
+        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
+      }
+    }
+    document.addEventListener('keydown', onKey);
+    if (onMount) onMount(backdrop, close);
+    // фокус — на первое поле диалога (или на кнопку закрытия)
+    const list = focusables();
+    const input = list.find((el) => /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
+    try { (input || list[0] || backdrop).focus(); } catch (e) {}
+    return { close, el: backdrop };
+  }
+
+  function confirmDialog(title, text, okLabel = 'Удалить') {
+    return new Promise((resolve) => {
+      modal({
+        title,
+        body: `<p>${esc(text)}</p>`,
+        footer: `<button class="btn" data-close>Отмена</button><button class="btn btn-danger" data-ok>${esc(okLabel)}</button>`,
+        onMount: (root, close) => {
+          root.querySelector('[data-ok]').onclick = () => { close(); resolve(true); };
+          root.querySelector('[data-close]').onclick = () => { close(); resolve(false); };
+          root.querySelector('.modal-foot [data-close]').onclick = () => { close(); resolve(false); };
+        },
+      });
+    });
+  }
+
+  /* ---- тема ---- */
+  const THEME_KEY = 'kopeikino:theme';
+  function applyTheme(t) {
+    document.documentElement.setAttribute('data-theme', t);
+    try { localStorage.setItem(THEME_KEY, t); } catch (e) {}
+  }
+  function initTheme() {
+    let t = 'light';
+    try { t = localStorage.getItem(THEME_KEY) || 'light'; } catch (e) {}
+    applyTheme(t);
+    const btn = document.getElementById('theme-toggle');
