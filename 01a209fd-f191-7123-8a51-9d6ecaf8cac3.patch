+        onMount: (root, close) => {
+          root.querySelector('[data-ok]').onclick = () => { close(); resolve(true); };
+          root.querySelector('[data-close]').onclick = () => { close(); resolve(false); };
+          root.querySelector('.modal-foot [data-close]').onclick = () => { close(); resolve(false); };
+        },
+      });
+    });
+  }
