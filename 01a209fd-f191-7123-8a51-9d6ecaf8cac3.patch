+:root{
+  --bg:#ffffff; --bg2:#f4f4f5; --card:#ffffff; --text:#09090b; --muted:#71717a;
+  --border:#e4e4e7; --primary:#16a34a; --primary-h:#15803d; --primary-soft:rgba(22,163,74,.10);
+  --gold:#f59e0b; --red:#e11d48; --ring:rgba(22,163,74,.35);
+  --shadow:0 8px 30px rgba(0,0,0,.08); --radius:16px; --radius-sm:12px;
+  --header-h:76px;
+}
+html[data-theme="dark"]{
+  --bg:#09090b; --bg2:#18181b; --card:#111113; --text:#fafafa; --muted:#a1a1aa;
+  --border:#27272a; --primary:#22c55e; --primary-h:#16a34a; --primary-soft:rgba(34,197,94,.14);
+  --shadow:0 8px 30px rgba(0,0,0,.5);
+}
+*{box-sizing:border-box;margin:0;padding:0}
+html{scroll-behavior:smooth}
+body{
+  background:var(--bg); color:var(--text); font-size:15px; line-height:1.5;
+  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
+  -webkit-font-smoothing:antialiased; min-height:100vh; display:flex; flex-direction:column;
+}
+a{color:inherit;text-decoration:none}
+button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
+input,select,textarea{font:inherit;color:inherit}
+img{max-width:100%;display:block}
+code{background:var(--bg2);padding:1px 5px;border-radius:6px;font-size:.9em}
+.container{width:100%;max-width:1220px;margin:0 auto;padding:0 20px}
+.muted{color:var(--muted)}
+.small{font-size:13px}
+.hidden{display:none !important}
+main{flex:1;padding:24px 0 56px}
+
+/* ---------- header ---------- */
+.header{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
+.header-inner{height:var(--header-h);display:flex;align-items:center;gap:18px}
+.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
+.logo-text{font-weight:800;font-size:19px;line-height:1.05;display:flex;flex-direction:column}
+.logo-text small{font-weight:500;font-size:11px;color:var(--muted);letter-spacing:.02em}
+.logo.small .logo-text{font-size:16px}
+.coin{
+  width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;
+  font-weight:900;font-size:21px;color:#fff;
+  background:conic-gradient(from 210deg,#86efac,var(--primary),#bbf7d0,var(--primary),#86efac);
+  box-shadow:inset 0 0 0 3px rgba(255,255,255,.35),0 4px 12px rgba(22,163,74,.35);
+}
+.logo.small .coin{width:30px;height:30px;font-size:16px}
+.search{flex:1;display:flex;gap:8px;max-width:620px}
+.search input{
+  flex:1;height:44px;padding:0 16px;border-radius:12px;border:1px solid var(--border);
+  background:var(--bg2);outline:none;transition:.15s;
+}
+.search input:focus{border-color:var(--primary);box-shadow:0 0 0 4px var(--primary-soft);background:var(--card)}
+.header-actions{display:flex;align-items:center;gap:8px;margin-left:auto}
+.icon-btn{
+  position:relative;width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;
+  border:1px solid transparent;transition:.15s;
+}
+.icon-btn:hover{background:var(--bg2);border-color:var(--border)}
+.badge{
+  position:absolute;top:2px;right:0;min-width:18px;height:18px;padding:0 5px;border-radius:9px;
+  background:var(--red);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;
+}
+
+/* ---------- buttons ---------- */
+.btn{
+  display:inline-flex;align-items:center;justify-content:center;gap:8px;
+  height:42px;padding:0 18px;border-radius:12px;border:1px solid var(--border);
+  background:var(--card);font-weight:600;white-space:nowrap;transition:.15s;
+}
+.btn:hover{border-color:var(--primary);color:var(--primary)}
+.btn-primary{background:var(--primary);border-color:var(--primary);color:#fff}
+.btn-primary:hover{background:var(--primary-h);border-color:var(--primary-h);color:#fff}
+.btn-ghost{background:transparent}
+.btn-sm{height:34px;padding:0 12px;font-size:13px;border-radius:10px}
+.btn-danger{color:var(--red);border-color:var(--border)}
+.btn-danger:hover{background:rgba(225,29,72,.08);border-color:var(--red);color:var(--red)}
+.btn[disabled]{opacity:.55;cursor:not-allowed}
+.btn-post{background:var(--primary);border-color:var(--primary);color:#fff}
+
+/* ---------- chips / pills ---------- */
+.chips{display:flex;gap:8px;flex-wrap:wrap}
+.chip{
+  height:34px;padding:0 14px;border-radius:999px;border:1px solid var(--border);background:var(--card);
+  display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;transition:.15s;
+}
+.chip:hover{border-color:var(--primary);color:var(--primary)}
+.chip.active{background:var(--primary);border-color:var(--primary);color:#fff}
+.pill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;background:var(--bg2);font-size:12px;font-weight:600;color:var(--muted)}
+.pill.green{background:var(--primary-soft);color:var(--primary)}
+.pill.gold{background:rgba(245,158,11,.14);color:#b45309}
+html[data-theme="dark"] .pill.gold{color:var(--gold)}
+.pill.red{background:rgba(225,29,72,.12);color:var(--red)}
+
+/* ---------- layout ---------- */
+.layout{display:grid;grid-template-columns:280px 1fr;gap:24px;align-items:start}
+.sidebar{position:sticky;top:calc(var(--header-h) + 16px);display:flex;flex-direction:column;gap:16px}
+.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
+.card-pad{padding:18px}
+.card-title{font-size:15px;font-weight:700;margin-bottom:12px}
+.side-link{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 10px;border-radius:10px;font-size:14px}
+.side-link:hover{background:var(--bg2)}
+.side-link.active{background:var(--primary-soft);color:var(--primary);font-weight:700}
+
+/* ---------- ads grid ---------- */
+.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px;flex-wrap:wrap}
+.page-title{font-size:26px;font-weight:800;letter-spacing:-.02em}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
+.ad-card{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;transition:.18s}
+.ad-card:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:color-mix(in srgb,var(--primary) 40%,var(--border))}
+.my-ad{display:flex;flex-direction:column;gap:0}
+.my-ad .ad-card{flex:1}
+.my-ad-actions{display:flex;padding:10px;border:1px solid var(--border);border-top:0;border-radius:0 0 var(--radius) var(--radius);background:var(--card)}
+.my-ad-actions .btn{width:100%}
+.ad-thumb{position:relative;aspect-ratio:4/3;background:var(--bg2);overflow:hidden}
+.ad-thumb img{width:100%;height:100%;object-fit:cover}
+.ad-thumb .noimg{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px;text-align:center;padding:10px}
+.ad-fav{position:absolute;top:8px;right:8px;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.45);color:#fff;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
+.ad-fav.on{color:#f43f5e}
+.ad-body{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}
+.ad-price{font-size:17px;font-weight:800}
+.ad-name{font-size:14px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:38px}
+.ad-meta{font-size:12px;color:var(--muted);display:flex;gap:6px;align-items:center;margin-top:auto}
+.ad-tags{display:flex;gap:4px;flex-wrap:wrap}
+.tag{font-size:11px;padding:2px 7px;border-radius:6px;background:var(--bg2);color:var(--muted)}
+
+/* ---------- hero ---------- */
+.hero{padding:28px;border-radius:22px;background:linear-gradient(120deg,var(--primary-soft),transparent 70%);border:1px solid var(--border);margin-bottom:22px}
+.hero h1{font-size:30px;line-height:1.15;letter-spacing:-.03em;margin-bottom:8px}
+.hero p{color:var(--muted);max-width:640px}
+.hero-actions{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
+
+/* ---------- ad page ---------- */
+.ad-page{display:grid;grid-template-columns:1.6fr 1fr;gap:24px;align-items:start}
+.gallery{border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);background:var(--bg2)}
+.gallery .main-img{aspect-ratio:4/3;width:100%;object-fit:cover}
+.gallery-thumbs{display:flex;gap:8px;padding:8px;overflow-x:auto}
+.gallery-thumbs img{width:64px;height:64px;object-fit:cover;border-radius:10px;border:2px solid transparent;cursor:pointer;opacity:.7}
+.gallery-thumbs img.active{border-color:var(--primary);opacity:1}
+.ad-details{padding:20px 0}
+.ad-details h1{font-size:24px;line-height:1.25;margin-bottom:10px;letter-spacing:-.02em}
+.price-big{font-size:32px;font-weight:900;letter-spacing:-.03em;margin:8px 0 4px}
+.specs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:16px 0}
+.spec{background:var(--bg2);border-radius:12px;padding:10px 12px}
+.spec dt{font-size:12px;color:var(--muted);margin-bottom:2px}
+.spec dd{font-weight:600;font-size:14px}
+.description{white-space:pre-wrap;margin-top:8px}
+.side-sticky{position:sticky;top:calc(var(--header-h) + 16px);display:flex;flex-direction:column;gap:14px}
+.owner{display:flex;align-items:center;gap:12px}
+.avatar{width:44px;height:44px;border-radius:50%;background:var(--primary-soft);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;flex-shrink:0}
+.avatar.lg{width:64px;height:64px;font-size:24px}
+.deal-options{display:flex;flex-direction:column;gap:8px}
+.deal-option{display:flex;gap:10px;align-items:flex-start;padding:10px;border-radius:12px;border:1px solid var(--border)}
+.deal-option .ic{width:28px;height:28px;border-radius:8px;background:var(--primary-soft);color:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0}
+
+/* ---------- forms ---------- */
+.form{display:flex;flex-direction:column;gap:16px;max-width:760px}
+.field{display:flex;flex-direction:column;gap:6px}
+.field label{font-size:13px;font-weight:700}
+.field .hint{font-size:12px;color:var(--muted)}
+.input,.select,.textarea{
+  width:100%;padding:11px 14px;border-radius:12px;border:1px solid var(--border);background:var(--card);outline:none;transition:.15s;
+}
+.textarea{min-height:120px;resize:vertical}
+.input:focus,.select:focus,.textarea:focus{border-color:var(--primary);box-shadow:0 0 0 4px var(--primary-soft)}
+.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+.check{display:flex;gap:10px;align-items:flex-start;padding:12px;border:1px solid var(--border);border-radius:12px;cursor:pointer}
+.check input{margin-top:3px;accent-color:var(--primary);width:18px;height:18px}
+.check.checked{border-color:var(--primary);background:var(--primary-soft)}
+.uploader{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:10px}
+.upload-tile{position:relative;aspect-ratio:1;border-radius:12px;overflow:hidden;border:1px solid var(--border)}
+.upload-tile img{width:100%;height:100%;object-fit:cover}
+.upload-tile .rm{position:absolute;top:4px;right:4px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.6);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px}
+.upload-add{aspect-ratio:1;border:2px dashed var(--border);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:var(--muted);font-size:12px}
+.upload-add:hover{border-color:var(--primary);color:var(--primary)}
+
+/* ---------- chat ---------- */
+.chat-wrap{display:grid;grid-template-columns:320px 1fr;gap:18px;height:calc(100vh - var(--header-h) - 120px);min-height:520px}
+.chat-list{overflow-y:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card)}
+.chat-item{display:flex;gap:10px;padding:12px;border-bottom:1px solid var(--border);cursor:pointer}
+.chat-item:hover{background:var(--bg2)}
+.chat-item.active{background:var(--primary-soft)}
+.chat-item .thumb{width:48px;height:48px;border-radius:10px;object-fit:cover;background:var(--bg2);flex-shrink:0}
+.chat-item .meta{min-width:0;flex:1}
+.chat-item .name{font-weight:700;font-size:14px;display:flex;justify-content:space-between;gap:8px}
+.chat-item .last{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.chat-panel{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);overflow:hidden}
+.chat-head{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border)}
+.messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:var(--bg2)}
+.msg{max-width:76%;padding:9px 13px;border-radius:14px;background:var(--card);border:1px solid var(--border);font-size:14px;word-wrap:break-word;white-space:pre-wrap;align-self:flex-start}
+.msg.mine{align-self:flex-end;background:var(--primary);border-color:var(--primary);color:#fff}
+.msg .time{display:block;font-size:10.5px;opacity:.65;margin-top:3px;text-align:right}
+.msg.deal{align-self:center;max-width:100%;background:var(--bg);border-style:dashed}
+.chat-input{display:flex;gap:8px;padding:12px;border-top:1px solid var(--border)}
+.chat-input textarea{flex:1;min-height:44px;max-height:120px;resize:none;padding:11px 14px;border-radius:12px;border:1px solid var(--border);background:var(--bg2);outline:none}
+.chat-input textarea:focus{border-color:var(--primary);background:var(--card)}
+
+/* ---------- cartochka sdelki ---------- */
+.deal-card{border:1px solid var(--border);border-radius:var(--radius);padding:14px;background:var(--card);display:flex;flex-direction:column;gap:10px}
+.deal-card .top{display:flex;gap:10px;align-items:center}
+.deal-card .top img{width:52px;height:52px;border-radius:10px;object-fit:cover;background:var(--bg2)}
+.deal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
+.deal-facts{display:flex;flex-direction:column;gap:4px;font-size:13px}
+.deal-facts b{font-weight:700}
+.actions{display:flex;gap:8px;flex-wrap:wrap}
+
+/* ---------- misc ---------- */
+.empty{padding:48px 20px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:var(--radius);background:var(--card)}
+.skeleton{background:linear-gradient(90deg,var(--bg2),var(--border),var(--bg2));background-size:200% 100%;animation:sh 1.2s infinite;border-radius:12px}
+@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}
+.toasts{position:fixed;right:20px;bottom:20px;display:flex;flex-direction:column;gap:8px;z-index:100}
+.toast{background:var(--text);color:var(--bg);padding:11px 16px;border-radius:12px;font-size:14px;box-shadow:var(--shadow);animation:in .2s ease}
+.toast.err{background:var(--red);color:#fff}
+@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
+.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:20px;z-index:90}
+.modal{background:var(--card);border-radius:18px;max-width:520px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 20px 60px rgba(0,0,0,.4)}
+.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--border)}
+.modal-body{padding:18px;display:flex;flex-direction:column;gap:14px}
+.modal-foot{display:flex;gap:8px;justify-content:flex-end;padding:14px 18px;border-top:1px solid var(--border)}
+.tabs{display:flex;gap:6px;border-bottom:1px solid var(--border);margin-bottom:18px;overflow-x:auto}
+.tab{padding:10px 14px;font-weight:600;font-size:14px;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}
+.tab.active{color:var(--primary);border-bottom-color:var(--primary)}
+
+/* ---------- footer ---------- */
+.footer{border-top:1px solid var(--border);padding:26px 0;background:var(--bg2)}
+.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:flex-start}
+.footer-links{display:flex;gap:16px;flex-wrap:wrap;font-size:14px}
+.footer-links a:hover{color:var(--primary)}
+
+/* ---------- responsive ---------- */
+@media (max-width:1000px){
+  .layout{grid-template-columns:1fr}
+  .sidebar{position:static;order:2}
+  .ad-page{grid-template-columns:1fr}
+  .side-sticky{position:static}
+  .chat-wrap{grid-template-columns:1fr;height:auto}
+  .chat-wrap .chat-list{max-height:260px}
+  .chat-panel{height:calc(100vh - var(--header-h) - 120px);min-height:480px}
+}
+@media (max-width:780px){
+  .header-inner{height:auto;padding:10px 0;flex-wrap:wrap;gap:10px}
+  .search{order:3;max-width:none;flex-basis:100%}
+  .btn-post span{display:none}
+  .logo-text small{display:none}
+  .row{grid-template-columns:1fr}
+  .specs{grid-template-columns:1fr}
+  .hero{padding:20px}
+  .hero h1{font-size:24px}
+  .page-title{font-size:21px}
+  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
+  .ad-name{min-height:auto}
+}
+
+/* Доступность: ссылка «к содержимому» видна только при фокусе с клавиатуры */
+.skip-link{position:absolute;left:-9999px;top:0;z-index:200;background:var(--primary);color:#fff;padding:10px 16px;border-radius:0 0 12px 0;font-weight:600}
+.skip-link:focus{left:0}
+/* Видимый фокус для клавиатуры (мышь не подсвечивает) */
+a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{
+  outline:3px solid var(--primary);outline-offset:2px;border-radius:8px
+}
+main:focus{outline:none}
+@media (prefers-reduced-motion: reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}
