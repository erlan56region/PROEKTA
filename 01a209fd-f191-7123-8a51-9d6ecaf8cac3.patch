+    state.chat = chat;
+    app.innerHTML = Views.chats({ me: state.me, chats: list.items, chat });
+    setUnread(list.unreadTotal);
+
+    const form = $('#chat-form');
+    if (form) {
+      const ta = form.querySelector('textarea');
