+  var seg = path.split('/').filter(Boolean);
+  if (path.charAt(path.length - 1) !== '/' && /\.[a-z0-9]+$/i.test(path)) seg.pop(); // отрезаем файл
+  if (seg.length > 1) seg = seg.slice(0, seg.length - 1); // остаётся только первый сегмент (база)
